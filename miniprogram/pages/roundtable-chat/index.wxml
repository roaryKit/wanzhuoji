<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen rt-chat-screen {{theme}}" style="height:{{windowHeight-keyboardHeight}}px"><view wx:if="{{error}}" class="rt-error">{{error}}</view><block wx:if="{{authorized&&table&&!joined}}"><scroll-view scroll-y class="rt-guest"><view class="large-title">{{table.name}}</view><view class="large-sub">{{table.count}} / {{table.capacity||8}} · {{table.interest}}</view><view class="card rt-guest-intro">{{table.intro}}</view><view class="card"><text class="headline">{{copy.rtRules}}</text><view class="sub">{{table.rules}}</view></view><view class="section-footer">{{copy.rtOnlyIntro}}</view><input class="rt-note" placeholder="{{copy.rtApplyNote}}" maxlength="80" value="{{note}}" bindinput="note"/><view wx:if="{{requestStatus==='pending'}}" class="section-footer">{{copy.rtApplied}}</view><view wx:elif="{{requestStatus==='rejected'}}" class="section-footer">{{copy.rtApplyRejected}}</view><button class="primary rt-guest-apply" loading="{{applyBusy}}" bindtap="apply">{{applyBusy?'提交中…':requestStatus==='pending'?copy.rtPending:table.full?copy.rtFull:copy.rtApply}}</button><view wx:if="{{applyFeedback}}" class="section-footer rt-apply-feedback">{{applyFeedback}}</view><view class="section-footer">{{copy.rtSafety}}</view></scroll-view></block><block wx:elif="{{authorized&&table&&joined}}"><view class="rt-room-header premium-compact-hero"><image class="premium-compact-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFill"/><view class="rt-room-heading"><text class="rt-room-name">{{table.name}}</text><text class="rt-room-count">{{copy.rtMembers}} {{table.count}} / {{table.capacity||8}}</text></view><view class="rt-room-actions"><button class="small rt-room-manage" bindtap="members">{{table.owner?copy.rtManageClose:copy.rtMembers}} ›</button><text wx:if="{{table.owner&&table.pendingCount>0}}" class="rt-room-pending" bindtap="members">{{copy.rtReviewLabel}} {{table.pendingCount}} ›</text><text wx:else class="rt-room-scope">{{copy.rtPrivacy}} · {{copy.rtTextOnly}}</text></view></view><view class="rt-table-panel" style="height:{{panelHeight}}px"><view class="rt-expanded {{collapsed?'rt-fading':''}}"><view class="rt-ring"><view class="rt-table"><text>{{table.count}} / {{table.capacity||8}}</text></view><view wx:for="{{seats}}" wx:key="key" class="rt-seat-avatar {{item.empty?'rt-empty-seat':''}}" style="left:{{item.x}}px;top:{{item.y}}px"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-id="{{item.id}}" binderror="avatarError"/><view wx:elif="{{!item.empty}}" class="ic ic-person"/></view><text wx:for="{{seats}}" wx:key="key" class="rt-seat-name" style="left:{{item.nx}}px;top:{{item.ny}}px">{{item.empty?copy.rtEmptySeat:item.name}}</text></view><view class="rt-table-caption"><text>{{table.formed?copy.rtFormed:copy.rtWaiting}}</text><text>{{copy.rtCollapseHint}}</text></view></view><view class="rt-compact {{collapsed?'rt-visible':''}}"><view class="rt-avatar-stack"><view wx:for="{{members}}" wx:key="id" class="avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-id="{{item.id}}" binderror="avatarError"/><view wx:else class="ic ic-person"/></view></view><view class="rt-compact-copy"><text>{{table.count}} / {{table.capacity||8}} {{copy.rtCount}}</text><text>{{copy.rtExpandHint}}</text></view></view></view><scroll-view id="rt-chat-scroll" class="rt-chat-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-anchoring="{{false}}" scroll-with-animation="{{false}}" scroll-into-view="{{into}}" scroll-top="{{scrollTop}}" bindscroll="onScroll" bindtouchstart="touchStart" bindtouchmove="touchMove"><view id="rt-chat-body"><view wx:if="{{next}}" class="rt-load-history" bindtap="history">{{copy.rtHistory}}</view><view wx:if="{{!rows.length}}" class="empty">{{copy.rtNoMessages}}</view><view wx:for="{{rows}}" wx:key="id" id="msg-{{item.id}}" class="rt-message {{item.mine?'rt-message-own':''}}" data-id="{{item.id}}" bindlongpress="messageMenu" bindtap="messageMenu"><view wx:if="{{item.deleted}}" class="rt-deleted">{{item.unsupported?copy.rtUnsupported:copy.rtDeleted}}</view><block wx:else><view class="avatar rt-chat-avatar"><image class="rt-chat-image" wx:if="{{item.author.avatar}}" src="{{item.author.avatar}}" mode="aspectFill" data-author="{{item.author.id}}" binderror="avatarError"/><text wx:else class="rt-chat-avatar-label">{{item.author.avatarState==='pending'?'待审':item.author.avatarState==='unavailable'?'头像':item.author.avatarLabel||'友'}}</text></view><view class="rt-message-main"><view class="rt-sender-line"><text class="rt-sender">{{item.author.name||copy.rtUnknownMember}}{{item.mine?' · 我':''}}</text><text wx:if="{{item.author.owner}}" class="rt-owner-tag">{{copy.rtOwner}}</text></view><text wx:if="{{item.author.profileHint}}" class="rt-profile-hint">{{item.author.profileHint}}</text><view class="rt-bubble"><view wx:if="{{item.quote}}" class="rt-inline-quote"><text class="accent">{{item.quote.name}}</text><text>{{item.quote.text}}</text></view><text class="rt-message-text">{{item.text}}</text><text class="rt-message-time">{{item.local?(item.failed?copy.rtFailed:copy.rtSending):item.pending?copy.rtAudit:item.rejected?copy.rtAuditRejected:item.time}}</text></view></view></block></view></view></scroll-view><view wx:if="{{newMessages}}" class="rt-new" bindtap="bottom">{{copy.rtNew}}</view><view class="rt-sync">{{reconnecting?copy.rtReconnecting:copy.rtSynced}}</view><view class="rt-composer {{keyboardHeight?'rt-keyboard-open':''}}"><view wx:if="{{replyTarget}}" class="rt-reply-context"><view><text class="accent">{{copy.rtReply}} {{replyTarget.name}}</text><text>{{replyTarget.text}}</text></view><view class="rt-close" bindtap="cancelReply" role="button" aria-label="{{copy.rtCancelReply}}">×</view></view><view class="rt-input-row"><input class="rt-chat-input" value="{{draft}}" bindinput="draft" placeholder="{{copy.rtMessagePlaceholder}}" placeholder-class="rt-placeholder" maxlength="500" confirm-type="send" adjust-position="{{false}}" bindkeyboardheightchange="keyboard" bindconfirm="send"/><button class="rt-chat-send" disabled="{{sending||!draft}}" bindtap="send">↑</button></view></view></block><profile-sheet id="profile-sheet"/></view>
