/* Every message, including mine, keeps a readable identity. */
.rt-chat-avatar{display:flex;align-items:center;justify-content:center;background:var(--primary-soft);border:1rpx solid var(--line)}.rt-chat-avatar-label{font-size:21rpx;line-height:26rpx;color:var(--text)}.rt-message-own{flex-direction:row;padding-left:0}.rt-message-own .rt-message-main{max-width:calc(100% - 80rpx)}.rt-message-own .rt-sender{text-align:left;margin-right:0}.rt-sender{color:var(--text);font-weight:500}

/* t143: owner controls remain a left-aligned independent row. */
.rt-room-header{position:relative;flex:none;display:flex;flex-direction:column;align-items:stretch;gap:8rpx;padding:14rpx 28rpx 16rpx;min-height:84rpx;box-sizing:border-box;border-bottom:1rpx solid var(--line);overflow:hidden}.rt-room-heading,.rt-room-actions{position:relative;z-index:1;display:flex;align-items:center;justify-content:flex-start;gap:14rpx;min-width:0;flex-wrap:wrap}.rt-room-name{font-family:var(--serif);font-size:29rpx;line-height:40rpx;color:var(--text);max-width:100%;word-break:break-all}.rt-room-count{font-size:22rpx;line-height:32rpx;color:var(--sub);white-space:nowrap}.rt-room-header .premium-compact-photo{left:auto;right:0;width:32%;opacity:.20;pointer-events:none}.rt-room-actions button.rt-room-manage{margin:0!important;height:auto;min-height:52rpx;line-height:32rpx;padding:8rpx 16rpx;font-size:23rpx;position:relative;z-index:1;max-width:100%}.rt-room-pending{font-size:23rpx;line-height:36rpx;color:var(--warn);padding:6rpx 8rpx}.rt-room-scope{font-size:20rpx;line-height:30rpx;color:var(--mute)}.rt-sender-line{display:flex;align-items:center;gap:8rpx;flex-wrap:wrap;margin-bottom:6rpx;min-height:30rpx}.rt-sender-line .rt-sender{margin:0;font-size:23rpx;line-height:32rpx;word-break:break-all;max-width:100%}.rt-owner-tag{font-size:18rpx;line-height:26rpx;color:var(--primary);background:var(--primary-soft);border-radius:8rpx;padding:0 8rpx}.rt-message{align-items:flex-start;justify-content:flex-start;flex-direction:row}.rt-message .rt-chat-avatar{align-self:flex-start;margin:0}.rt-message .rt-message-main{min-width:0;max-width:calc(100% - 80rpx)}.rt-message-own .rt-bubble{border-radius:26rpx 26rpx 8rpx 26rpx}
.rt-profile-hint{display:block;font-size:20rpx;line-height:30rpx;color:var(--mute);margin:0 0 6rpx;word-break:break-all}

/* t144: direction is mine only, never owner. Identity stays top-aligned. */
