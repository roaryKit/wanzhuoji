<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="shell main-shell {{theme}}" style="--main-nav-height:{{navHeight}}px;padding-top:{{navHeight}}px;"><view class="main-brand" style="height:{{navHeight}}px;"><view class="main-brand-row" style="top:{{brandTop}}px;height:{{brandHeight}}px;left:{{brandSide}}px;right:{{brandSide}}px;">{{copy.shareTitle}}</view></view><view wx:if="{{error && !authorized}}" class="screen tab-screen {{theme}}"><view class="error">{{error}}</view><button class="primary" bindtap="onRetry">{{copy.retry}}</button></view><view wx:if="{{visited.home}}" hidden="{{tab!=='home' || (error && !authorized)}}"><tab-home id="tab-home" theme="{{theme}}" authorized="{{authorized}}" user="{{user}}" bind:retry="onRetry" bind:user="onUser"/></view><view wx:if="{{visited.plaza}}" hidden="{{tab!=='plaza' || (error && !authorized)}}"><tab-plaza id="tab-plaza" theme="{{theme}}" authorized="{{authorized}}" user="{{user}}" active="{{tab==='plaza'}}" bind:retry="onRetry" bind:user="onUser"/></view><view wx:if="{{visited.wines}}" hidden="{{tab!=='wines' || (error && !authorized)}}"><tab-wines id="tab-wines" theme="{{theme}}" authorized="{{authorized}}" user="{{user}}" bind:retry="onRetry" bind:user="onUser"/></view><view wx:if="{{visited.settings}}" hidden="{{tab!=='settings' || (error && !authorized)}}"><tab-settings id="tab-settings" theme="{{theme}}" authorized="{{authorized}}" user="{{user}}" bind:retry="onRetry" bind:user="onUser"/></view><view class="tabbar {{theme}}"><view wx:for="{{tabs}}" wx:key="key" class="tabbar-item {{tab===item.key?'on':''}}" data-tab="{{item.key}}" bindtap="selectTab"><view class="ic tabbar-icon ic-{{item.icon}}{{tab===item.key?'-f':''}}"/><text class="tabbar-text">{{item.text}}</text></view></view></view>
