<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="large-title">{{copy.rtCreate}}</view></view></view><view class="section-footer">{{copy.rtJoinLimit}}</view><view class="card rt-form"><text>{{copy.rtName}}</text><input value="{{form.name}}" data-field="name" bindinput="input" maxlength="20"/><text>{{copy.rtIntro}}</text><textarea value="{{form.intro}}" data-field="intro" bindinput="input" maxlength="140"/><text>{{copy.rtCapacity}}</text><view class="premium-capacities"><button wx:for="{{capacityChoices}}" wx:key="*this" class="premium-capacity {{form.capacity===item?'selected':''}}" disabled="{{editing}}" data-index="{{index}}" bindtap="chooseCapacity">{{item}}</button></view><text class="section-footer">{{copy.rtCapacityNote}}</text><text>{{copy.rtInterest}}</text><input value="{{form.interest}}" data-field="interest" bindinput="input" maxlength="16"/><text>{{copy.rtRules}}</text><textarea value="{{form.rules}}" data-field="rules" bindinput="input" maxlength="200"/></view><text class="section-footer">{{copy.rtSafety}}</text><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" disabled="{{busy}}" bindtap="save">{{copy.rtSave}}</button></view>
