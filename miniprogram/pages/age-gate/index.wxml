<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen age-screen {{theme}}">
<view class="age-reading" wx:if="{{!denied}}"><view class="eyebrow">{{copy.ageContext}}</view><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title age-title">{{copy.ageTitle}}</view></view></view><view class="card age-card"><view class="age-legal">{{copy.age}}</view><view class="foot age-notice">{{copy.notice}}</view></view></view>
<view wx:else class="age-reading"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title age-title">{{copy.underage}}</view></view></view><view class="sub age-notice">{{copy.close}}</view></view>
<view class="age-actions" wx:if="{{!denied}}"><view wx:if="{{busy}}" class="sub status">{{copy.initializing}}</view><view wx:if="{{error}}" class="error status">{{error}}</view><button wx:if="{{error}}" class="primary" bindtap="initialize" disabled="{{busy}}">{{copy.retry}}</button><button wx:else class="primary" bindtap="confirm" disabled="{{busy||!ready}}">{{copy.confirmAge}}</button><button class="plain secondary" bindtap="deny" disabled="{{busy}}">{{copy.denyAge}}</button></view>
</view>
