<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="onShow">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><canvas type="2d" id="image-compress" style="position:fixed;left:-10000px;width:1px;height:1px"/><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title">{{copy.writeTitle}}</view></view></view><view class="section-header">{{copy.wineHeader}}</view><view class="group"><view class="cell"><text class="cell-key">{{copy.wineName}}</text><input class="cell-input" value="{{form.wineName}}" maxlength="30" placeholder="{{copy.required}}" data-key="wineName" bindinput="input"/></view><view class="cell sep" hover-class="cell-hover" bindtap="chooseWine"><text class="cell-label accent">{{copy.loadWines}}</text><view class="ic ic-chev chev"/></view><picker wx:if="{{wineOptions.length}}" range="{{wineOptions}}" range-key="name" bindchange="chooseWineOption"><view class="cell sep"><text class="cell-label">{{copy.pickFromWines}}</text><view class="ic ic-chev chev"/></view></picker><picker range="{{categories}}" bindchange="category"><view class="cell sep"><text class="cell-label">{{copy.category}}</text><text class="cell-value">{{form.category}}</text><view class="ic ic-chev chev"/></view></picker><view class="cell sep"><text class="cell-key">{{copy.abv}}</text><input class="cell-input" value="{{form.abv}}" type="digit" placeholder="0–100" data-key="abv" bindinput="input"/><text class="cell-unit">°</text></view><view class="cell sep"><text class="cell-key">{{copy.volume}}</text><input class="cell-input" value="{{form.volumeMl}}" type="digit" placeholder="{{copy.optional}}" data-key="volumeMl" bindinput="input"/><text class="cell-unit">ml</text></view></view><view class="section-header"><text>{{copy.place}}</text><text class="accent">{{form.place}}</text></view><view class="group"><view class="chip-block"><view class="chips"><text class="chip {{form.place===item?'chosen':''}}" wx:for="{{places}}" wx:key="*this" data-value="{{item}}" bindtap="place">{{item}}</text></view><view class="link-btn" hover-class="link-hover" data-type="customPlaces" bindtap="custom"><view class="ic ic-plus link-ic"/><text>{{copy.customPlace}}</text></view></view></view><view class="section-header">{{copy.moodHeader}}</view><view class="group"><view class="chip-block"><tag-picker options="{{tags}}" value="{{form.moodTags}}" bind:change="tags"/><view class="link-btn" hover-class="link-hover" data-type="customTags" bindtap="custom"><view class="ic ic-plus link-ic"/><text>{{copy.customTag}}</text></view></view></view><view class="section-header"><text>{{copy.textHeader}}</text><text>{{form.text.length}} / 200</text></view><view class="card form-card"><textarea value="{{form.text}}" maxlength="200" placeholder="{{copy.placeholder}}" data-key="text" bindinput="input"/></view><view class="section-header"><text>{{copy.photosHeader}}</text><text>{{photos.length}} / {{maxPhotos}}</text></view><view class="group photo-group"><view class="photo-grid"><view wx:for="{{photos}}" wx:key="key" class="photo-tile"><image class="photo-img" src="{{item.url}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"/><view wx:if="{{item.uploading}}" class="photo-mask"><view class="photo-spinner"/><text class="photo-pct">{{item.progress}}%</text></view><view wx:else class="photo-remove" data-index="{{index}}" catchtap="removeImage"><view class="ic ic-plus photo-remove-x"/></view></view><view wx:if="{{photos.length<maxPhotos}}" class="photo-tile photo-add" hover-class="photo-add-hover" bindtap="image"><view class="photo-add-inner"><view class="ic ic-plus photo-add-ic"/><text class="photo-add-text">{{copy.addPhoto}}</text></view></view></view></view><text class="section-footer">{{copy.photosFooter}}</text><view class="section-header">{{copy.soloQuestion}}</view><radio-group class="group" bindchange="solo"><label class="cell"><text class="cell-label">{{copy.yesSolo}}</text><radio color="{{theme==='light'?'#A67C3A':'#C4A060'}}" value="yes" checked="{{form.isSolo}}"/></label><label class="cell sep"><text class="cell-label">{{copy.no}}</text><radio color="{{theme==='light'?'#A67C3A':'#C4A060'}}" value="no" checked="{{!form.isSolo}}"/></label></radio-group><view class="section-header">{{copy.whoCanSee}}</view><radio-group class="group" bindchange="privacy"><label class="cell"><text class="cell-label">{{copy.privateLabel}}</text><radio color="{{theme==='light'?'#A67C3A':'#C4A060'}}" value="private" checked="{{form.privacy==='private'}}"/></label><label class="cell sep {{form.isSolo?'':'cell-disabled'}}"><text class="cell-label">{{copy.publicToPlaza}}</text><radio color="{{theme==='light'?'#A67C3A':'#C4A060'}}" value="public" disabled="{{!form.isSolo}}" checked="{{form.privacy==='public'}}"/></label></radio-group><text wx:if="{{!form.isSolo}}" class="section-footer">{{copy.soloOnlyPublic}}</text><button class="primary submit" bindtap="submit" disabled="{{busy||toast}}">{{copy.submit}}</button><fade-toast visible="{{toast}}" text="{{toastText}}"/><view wx:if="{{glow}}" class="glow"/><text class="center-footer">{{copy.footer}}</text></block><profile-sheet id="profile-sheet"/></view>
