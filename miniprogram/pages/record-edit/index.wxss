.form-card{padding:28rpx 32rpx}
.form-card textarea{height:280rpx}
/* iOS 分组卡片：可换行胶囊 + 轻量着色文字按钮 */
.chip-block{padding:28rpx 32rpx 8rpx}
.link-btn{display:inline-flex;align-items:center;gap:10rpx;min-height:80rpx;padding:0 8rpx;margin-left:-8rpx;font-size:30rpx;line-height:40rpx;font-weight:500;color:var(--primary)}
.link-hover{opacity:.5}
.link-ic{width:28rpx;height:28rpx;background-color:var(--primary)}
/* 照片：三列等宽方格（与网格同间距），已选照片 + 虚线添加格 */
.photo-group{padding:24rpx}
.photo-grid{display:flex;flex-wrap:wrap;gap:16rpx}
.photo-tile{position:relative;flex:none;width:calc((100% - 32rpx) / 3);border-radius:20rpx;background:var(--fill)}
.photo-tile::before{content:'';display:block;padding-top:100%}
.photo-img{position:absolute;left:0;top:0;width:100%;height:100%;border-radius:20rpx}
.photo-tile::after{content:'';position:absolute;left:0;top:0;right:0;bottom:0;border-radius:20rpx;border:1px solid var(--line);pointer-events:none}
.photo-remove{position:absolute;top:10rpx;right:10rpx;width:44rpx;height:44rpx;border-radius:22rpx;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;z-index:2}
.photo-remove::before{content:'';position:absolute;left:-16rpx;right:-16rpx;top:-16rpx;bottom:-16rpx}
.photo-remove-x{width:24rpx;height:24rpx;background-color:#fff;transform:rotate(45deg)}
.photo-mask{position:absolute;left:0;top:0;right:0;bottom:0;border-radius:20rpx;background:rgba(0,0,0,.45);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;z-index:2}
.photo-spinner{width:44rpx;height:44rpx;border-radius:50%;border:4rpx solid rgba(255,255,255,.3);border-top-color:#fff;box-sizing:border-box;animation:photo-spin .8s linear infinite}
@keyframes photo-spin{to{transform:rotate(360deg)}}
.photo-pct{font-size:24rpx;line-height:32rpx;color:#fff;font-variant-numeric:tabular-nums}
.photo-add{background:transparent}
.photo-add::after{border:2rpx dashed var(--sep)}
.photo-add-inner{position:absolute;left:0;top:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx}
.photo-add-ic{width:44rpx;height:44rpx;background-color:var(--primary)}
.photo-add-text{font-size:26rpx;line-height:36rpx;color:var(--sub)}
.photo-add-hover{background:var(--fill)}
.cell-disabled{opacity:.45}
.submit{margin-top:56rpx}

.screen .title,.screen .large-title{font-family:var(--serif);font-weight:500;color:var(--gold-soft)}.screen .card,.screen .group{border:1rpx solid var(--sep);background:linear-gradient(135deg,var(--card-top),transparent 70%),var(--card);box-shadow:0 8rpx 24rpx var(--shadow)}.screen button.primary{border-radius:44rpx;background:linear-gradient(180deg,var(--btn-top),var(--btn-mid) 53%,var(--btn-bottom));color:var(--on-primary)}
