<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="onShow">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title">{{single?copy.singleTitle:copy.monthlyTitle}}</view><text class="large-sub">{{copy.exportSub}}</text></view></view><picker wx:if="{{!single}}" class="export-picker" mode="date" fields="month" value="{{month}}" bindchange="month"><view class="group"><view class="cell"><text class="cell-label">{{copy.pickMonth}}</text><text class="cell-value">{{month}}</text><view class="ic ic-chev chev"/></view></view></picker><view class="poster-wrap"><canvas type="2d" id="poster"/></view><button class="primary" bindtap="generate" disabled="{{busy}}">{{copy.generateCard}}</button><button wx:if="{{path}}" bindtap="save" disabled="{{busy}}">{{copy.saveAlbum}}</button><text class="center-footer">{{copy.footer}}</text></block></view>
