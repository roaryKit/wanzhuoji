<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="onShow">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view wx:if="{{unavailable}}" class="empty">{{copy.unavailable}}</view><view wx:if="{{record}}"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title">{{record.wineName}}</view><text class="large-sub">{{date}} · {{record.category}}</text></view></view><view wx:if="{{author}}" class="detail-author"><image wx:if="{{author.avatar}}" class="avatar detail-avatar" src="{{author.avatar}}" mode="aspectFill"/><view wx:else class="avatar detail-avatar"><view class="ic ic-person"/></view><text class="detail-author-name">{{author.name}}</text></view><view wx:if="{{record.place||record.moodTags.length||record.text||photos.length}}" class="card detail-card"><view wx:if="{{record.place||record.moodTags.length}}" class="detail-tags"><text wx:if="{{record.place}}" class="tag">{{record.place}}</text><text wx:for="{{record.moodTags}}" wx:key="*this" class="tag">{{item}}</text></view><view wx:if="{{record.text||photos.length}}" class="detail-body {{record.place||record.moodTags.length?'with-head':''}} {{photosOpen?'detail-body-open':''}}"><view class="detail-main"><view wx:if="{{record.text}}" class="detail-text serif">{{record.text}}</view></view><view wx:if="{{photos.length}}" class="detail-photos"><photo-stack urls="{{photos}}" mode="detail" bind:toggle="photosToggle"/></view></view></view><block wx:if="{{social}}"><view class="social-bar"><view class="social-act {{liked?'on':''}}" bindtap="like"><view class="ic ic-{{liked?'heart-fill':'heart'}} social-ic"/><text>{{copy.like}}</text><text wx:if="{{likeCount}}" class="social-n">{{likeCount}}</text></view><view class="social-act" bindtap="focusInput"><view class="ic ic-comment social-ic"/><text>{{copy.comment}}</text><text wx:if="{{commentCount}}" class="social-n">{{commentCount}}</text></view><button class="social-act social-share" open-type="share"><view class="ic ic-share social-ic"/><text>{{copy.share}}</text></button></view><view class="section-header"><text>{{copy.commentsHeader}}{{commentCount?' · '+commentCount:''}}</text></view><view wx:if="{{comments.length}}" class="group comment-list"><view wx:for="{{comments}}" wx:key="id" class="comment {{item.replyTo?'comment-reply':''}}"><image wx:if="{{item.avatar}}" class="avatar comment-avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="avatar comment-avatar"><view class="ic ic-person"/></view><view class="comment-body"><view class="comment-head"><text class="comment-name {{item.byAuthor?'is-author':''}}">{{item.handle}}</text><text wx:if="{{item.byAuthor && item.handle!==copy.authorTag}}" class="comment-tag">{{copy.authorTag}}</text><block wx:if="{{item.replyTo}}"><text class="comment-reply-word">{{copy.reply}}</text><text class="comment-name comment-target {{item.replyDeleted?'comment-deleted':''}}">{{item.replyDeleted?copy.replyDeleted:item.replyHandle}}</text></block></view><view class="comment-text" data-id="{{item.id}}" bindtap="reply">{{item.text}}</view><view class="comment-meta"><text class="comment-time">{{item.time}}</text><text wx:if="{{!item.pending}}" class="comment-reply-action" data-id="{{item.id}}" bindtap="reply">{{copy.reply}}</text><text wx:if="{{item.canDelete}}" class="comment-del" data-id="{{item.id}}" bindtap="removeComment">{{copy.deleteComment}}</text></view><text wx:if="{{item.pending}}" class="badge comment-badge">{{copy.commentPending}}</text></view></view></view><view wx:else class="comment-empty">{{copy.commentEmpty}}</view><view wx:if="{{moreComments}}" class="comment-more" bindtap="loadMore">{{copy.moreComments}}</view></block><block wx:if="{{!pub}}"><view class="group"><view class="cell"><text class="cell-label">{{copy.abv}}</text><text class="cell-value">{{record.abv===undefined||record.abv===null?'—':record.abv}}°</text></view><view class="cell"><text class="cell-label">{{copy.volume}}</text><text class="cell-value">{{record.volumeMl===undefined||record.volumeMl===null?'—':record.volumeMl}} ml</text></view><view class="cell"><text class="cell-label">{{copy.solo}}</text><text class="cell-value">{{record.isSolo?copy.solo:copy.notSolo}}</text></view><view class="cell"><text class="cell-label">{{copy.visibility}}</text><text class="cell-value">{{record.privacy==='private'?copy.privateLabel:copy.publicLabel}}</text></view><view class="cell"><text class="cell-label">{{copy.audit}}</text><text class="cell-value">{{copy.auditLabels[record.auditStatus]||record.auditStatus}}{{record.auditReason?' · '+record.auditReason:''}}</text></view></view><view class="section-footer">{{copy.createdAt}}{{created}}<view>{{copy.updatedAt}}{{updated}}</view></view><view class="detail-actions"><button class="primary detail-first" bindtap="edit">{{copy.edit}}</button><button bindtap="privacy" disabled="{{busy||(!record.isSolo && record.privacy==='private')}}">{{record.privacy==='private'?copy.toPublic:copy.toPrivate}}</button><button class="danger" bindtap="remove" disabled="{{busy}}">{{copy.delete}}</button></view></block><view wx:if="{{social}}" class="comment-spacer {{replyTarget?'has-reply':''}}"/></view><view wx:if="{{social}}" class="comment-bar {{keyboardHeight?'keyboard-open':''}}" style="bottom:{{keyboardHeight}}px"><view wx:if="{{replyTarget}}" class="reply-context"><text class="reply-context-name">{{copy.reply}} {{replyTarget.handle}}</text><view class="reply-cancel" role="button" aria-label="{{copy.cancelReply}}" bindtap="cancelReply"><view class="reply-close-icon"/></view></view><view class="comment-input-row"><input class="comment-input" value="{{draft}}" maxlength="200" placeholder="{{replyTarget?copy.reply+' '+replyTarget.handle:copy.commentPlaceholder}}" placeholder-class="comment-ph" confirm-type="send" focus="{{focus}}" cursor-spacing="0" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboard" bindinput="onDraft" bindconfirm="send" bindblur="onBlur"/><button class="comment-send" disabled="{{sending||!draftOk}}" bindtap="send">{{copy.send}}</button></view></view></block><profile-sheet id="profile-sheet"/></view>
