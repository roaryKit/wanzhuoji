<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="onShow">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view wx:if="{{wine}}"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title">{{wine.name}}</view><text class="large-sub">{{wine.category}} · {{records.length}}{{copy.recordsSuffix}}</text></view></view><view class="section-header">{{copy.tasting}}</view><view class="group"><view class="cell"><text class="cell-label">{{copy.category}}</text><text class="cell-value">{{wine.category}}</text></view><picker range="{{ratings}}" value="{{wine.rating}}" bindchange="rating"><view class="cell sep"><text class="cell-label">{{copy.rating}}</text><text class="cell-value">{{ratings[wine.rating]}}</text><view class="ic ic-chev chev"/></view></picker><view class="cell sep note-cell"><textarea maxlength="200" value="{{wine.note}}" bindinput="note" placeholder="{{copy.notePlaceholder}}"/></view></view><button class="primary" bindtap="save" disabled="{{busy}}">{{copy.saveTasting}}</button><view wx:if="{{records.length}}" class="section-header">{{copy.relatedRecords}}</view><record-card wx:for="{{records}}" wx:key="_id" record="{{item}}" bind:open="open" bind:export="export"/></view></block></view>
