<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="onShow">{{copy.retry}}</button><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="pf-head premium-profile-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><button class="pf-avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}"><image wx:if="{{profile.avatarURL}}" class="avatar pf-avatar" src="{{profile.avatarURL}}" mode="aspectFill"/><view wx:else class="avatar pf-avatar"><view class="ic ic-person"/></view><text class="pf-change">{{copy.changeAvatar}}</text></button><text wx:if="{{profile.avatarStatus==='pending'}}" class="foot pf-note">{{copy.avatarPending}}</text><text wx:if="{{profile.avatarStatus==='reject'}}" class="foot pf-note pf-warn">{{copy.avatarReject}}</text></view><view class="section-header">{{copy.groupProfile}}</view><view class="group"><view class="cell"><text class="pf-label">{{copy.nicknameLabel}}</text><input type="nickname" class="pf-input" value="{{nickname}}" placeholder="{{copy.nicknamePlaceholder}}" placeholder-class="pf-ph" maxlength="16" bindinput="onNick" bindblur="onNick" bindconfirm="saveNick"/></view></view><text wx:if="{{profile.nicknamePending}}" class="section-footer">{{copy.nicknamePending}}</text><button class="primary pf-save" disabled="{{busy||!nickDirty}}" bindtap="saveNick">{{copy.save}}</button><view class="section-header">{{copy.groupPrivacy}}</view><view class="group"><label class="cell"><text class="cell-label">{{copy.anonymousRow}}</text><switch color="{{theme==='light'?'#A67C3A':'#C4A060'}}" disabled="{{busy}}" checked="{{profile.anonymous}}" bindchange="setAnon"/></label></view><text class="section-footer">{{copy.anonymousFooter}}</text></block></view>
