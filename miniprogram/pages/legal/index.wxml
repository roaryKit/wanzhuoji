<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="onShow">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="title">{{copy.legalTitle}}</view></view></view><view class="section-header">{{copy.legalAgeHeader}}</view><view class="card legal-card">{{copy.age}}<view>{{copy.notice}}</view></view><view class="section-header">{{copy.legalServiceHeader}}</view><view class="card legal-card">{{copy.legal1}}<view>{{copy.legal2}}</view><view>{{copy.legal3}}</view><view>{{copy.legal4}}</view></view></block></view>
