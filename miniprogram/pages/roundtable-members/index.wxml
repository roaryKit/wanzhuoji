<page-meta root-background-color="{{pageBackground}}" background-color="{{pageBackground}}" background-color-top="{{pageBackground}}" background-color-bottom="{{pageBackground}}" page-style="background-color: {{pageBackground}};"/><view class="screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{authorized&&table}}"><view class="premium-plaza-hero premium-page-hero premium-inner-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="large-title">{{table.name}}</view><view class="large-sub">{{copy.rtMemberPrivacy}} · {{table.count}} / {{table.capacity||8}}</view></view></view><block wx:if="{{table.owner}}"><view class="rt-owner-actions"><button class="small" bindtap="edit">{{copy.rtEdit}}</button><button class="small danger rt-dissolve" bindtap="dissolve">{{copy.rtDissolveAction}}</button></view><view id="rt-review-section" class="section-header">{{copy.rtApplications}} · <text class="rt-pending-count">{{requestTotal}}</text></view><view class="section-footer">{{copy.rtSiteNotice}}</view><view wx:if="{{!requests.length}}" class="section-footer">{{copy.rtNoApplications}}</view><view wx:for="{{requests}}" wx:key="id" class="card"><view class="headline">{{item.name}}</view><view class="sub">{{item.note}}</view><view class="rt-approval-actions"><button class="small primary rt-accept" data-id="{{item.id}}" data-accept="true" bindtap="approve">{{copy.rtAccept}}</button><button class="small rt-decline" data-id="{{item.id}}" data-accept="false" bindtap="approve">{{copy.rtDecline}}</button></view></view><button wx:if="{{requestNext}}" class="small rt-more-requests" bindtap="moreRequests" disabled="{{requestLoading}}">{{copy.rtMoreRequests}}</button></block><view class="group rt-members"><view wx:for="{{members}}" wx:key="id" class="cell tall" data-id="{{item.id}}" bindtap="memberAction"><view class="avatar rt-member-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-id="{{item.id}}" binderror="avatarError"/><text wx:else class="rt-avatar-fallback">{{item.avatarState==='pending'?'待审':item.avatarState==='unavailable'?'头像':item.name?item.name[0]:'友'}}</text></view><text class="cell-label">{{item.name}}</text><text class="cell-value">{{item.owner?copy.rtOwner:item.self?copy.rtSelf:''}}</text></view></view><view class="section-footer">{{copy.rtAvatarBoundary}}</view><view class="section-header">{{copy.rtRules}}</view><view class="card sub">{{table.rules}}</view><text class="section-footer">{{copy.rtSafety}}</text><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!table.owner}}" class="danger rt-leave" bindtap="leave">{{copy.rtLeave}}</button></block></view>
