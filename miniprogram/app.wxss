@import "styles/main-top.wxss";
/* 晚酌集 v3 · iOS 风格（1pt = 2rpx）。界面字体为苹方/系统字体，宋体只用于首页标语和记录正文。 */
page{--gutter:32rpx;--radius:28rpx;--group-radius:24rpx;--control:100rpx;background:#110E0F;color:#EDEAE5;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Helvetica Neue','Hiragino Sans GB','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-weight:400;font-size:34rpx;line-height:1.41;-webkit-font-smoothing:antialiased}
.shell,.screen{--bg:#110E0F;--card:#241C18;--card2:#2C2C33;--fill:rgba(118,118,128,.24);--line:rgba(255,255,255,.08);--sep:rgba(84,84,88,.55);--text:#EDEAE5;--sub:#A7AFBE;--mute:#7C8290;--primary:#C4A060;--primary-soft:rgba(198,155,118,.16);--on-primary:#17171A;--warn:#E0897C;--warn-soft:rgba(224,137,124,.15);--tile-fg:#17171A;--bar:rgba(22,22,26,.94);--serif:'Noto Serif SC','Source Han Serif SC','Songti SC','STSong',serif}
.shell.light,.screen.light{--bg:#F3EBE0;--card:#FFFBF5;--card2:#EDE8E2;--fill:rgba(118,118,128,.12);--line:rgba(43,41,38,.07);--sep:rgba(60,60,67,.18);--text:#2B2926;--sub:#626975;--mute:#8E929A;--primary:#A67C3A;--primary-soft:rgba(128,86,55,.10);--on-primary:#FFFAF4;--warn:#B0574A;--warn-soft:rgba(176,87,74,.10);--tile-fg:#FFFAF4;--bar:rgba(249,246,242,.94)}
.screen{background:var(--bg);color:var(--text);min-height:100vh;padding:8rpx var(--gutter) calc(64rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow-wrap:break-word;word-break:break-word}
.screen.tab-screen{padding-bottom:calc(var(--gutter) + 49px + env(safe-area-inset-bottom))}

/* iOS 字号层级 */
.large-title,.title{display:block;font-size:68rpx;font-weight:700;line-height:82rpx;letter-spacing:.8rpx;padding:8rpx 8rpx 0;margin:0;color:var(--text)}
.large-sub{display:block;font-size:30rpx;line-height:40rpx;color:var(--sub);padding:4rpx 8rpx 0}
.tagline{display:block;font-family:var(--serif);font-size:34rpx;line-height:52rpx;color:var(--sub);padding:8rpx 8rpx 0}
.headline{font-size:34rpx;font-weight:600;line-height:44rpx}
.title3{font-size:40rpx;font-weight:600;line-height:50rpx}
.body{font-size:34rpx;line-height:48rpx}
.serif{font-family:var(--serif)}
.sub{color:var(--sub);font-size:30rpx;line-height:40rpx}
.foot{color:var(--mute);font-size:26rpx;line-height:36rpx}
.capt{color:var(--mute);font-size:24rpx;line-height:32rpx}
.accent{color:var(--primary)}
.warn,.error{color:var(--warn)}
.error{display:block;font-size:30rpx;line-height:42rpx;white-space:pre-wrap;background:var(--warn-soft);border-radius:var(--group-radius);padding:24rpx 32rpx;margin:24rpx 0}
.loading{display:flex;align-items:center;min-height:88rpx;padding:0 8rpx}
.empty{display:block;text-align:center;padding:96rpx 32rpx;color:var(--mute);font-size:30rpx;line-height:44rpx}

/* 分组标题 / 说明 */
.section-header{display:flex;justify-content:space-between;align-items:baseline;gap:16rpx;font-size:26rpx;line-height:36rpx;color:var(--mute);margin:48rpx 32rpx 14rpx;letter-spacing:.6rpx}
.section-header .accent{flex:none}
.section-footer{display:block;font-size:26rpx;line-height:36rpx;color:var(--mute);margin:14rpx 32rpx 0}
.center-footer{display:block;text-align:center;font-size:26rpx;line-height:36rpx;color:var(--mute);margin:56rpx 32rpx 0}

/* 卡片与 iOS 分组列表 */
.card{background:var(--card);border-radius:var(--radius);padding:36rpx 36rpx 32rpx;margin:0 0 24rpx;box-sizing:border-box}
.group{background:var(--card);border-radius:var(--group-radius);overflow:hidden}
.cell{position:relative;display:flex;align-items:center;gap:28rpx;min-height:96rpx;padding:0 32rpx;box-sizing:border-box;color:var(--text)}
.cell.tall{min-height:128rpx}
.cell+.cell::before,.cell.sep::before{content:'';position:absolute;top:0;right:0;left:32rpx;height:1px;background:var(--sep);transform:scaleY(.5);transform-origin:0 0}
.group.tiles .cell+.cell::before,.group.tiles .cell.sep::before{left:118rpx}
.cell-hover{background:var(--fill)}
.cell-label{flex:1;min-width:0;font-size:34rpx;line-height:44rpx;padding:22rpx 0}
.cell-label.warn{color:var(--warn)}
.cell-note{display:block;font-size:26rpx;line-height:36rpx;color:var(--mute);margin-top:4rpx}
.cell-key{flex:none;width:136rpx;font-size:34rpx;line-height:44rpx}
.cell-value{flex:none;max-width:60%;font-size:34rpx;line-height:44rpx;color:var(--mute);text-align:right}
.cell-input{flex:1;min-width:0;text-align:left}
.cell-unit{flex:none;font-size:34rpx;color:var(--mute)}
.chev{width:18rpx;height:30rpx;background-color:var(--mute);opacity:.7}
.tile{flex:none;width:60rpx;height:60rpx;border-radius:14rpx;background:var(--primary);display:flex;align-items:center;justify-content:center}
.tile .ic{width:38rpx;height:38rpx;background-color:var(--tile-fg)}
.tile.warn-tile{background:var(--warn)}

/* 按钮：主按钮 50pt 实心，次按钮浅色填充 */
button{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:16rpx;width:100%;min-height:var(--control);height:auto;padding:0 32rpx;margin:24rpx 0;border:0;border-radius:28rpx;background:var(--primary-soft);color:var(--primary);font-family:inherit;font-size:34rpx;font-weight:600;line-height:1.3;white-space:nowrap}
/* 覆盖微信 style:v2 内置 button:not([size=mini]){width:184px;margin:auto} —— 否则无 class 的按钮变成居中窄胶囊、长文字被裁切。按钮统一通栏，文字过长时换行而不是溢出。 */
button:not([size=mini]){width:100%;max-width:100%;margin-left:0;margin-right:0;padding:16rpx 32rpx;white-space:normal;text-align:center;overflow:hidden}
button::after{border:0!important;display:none!important}
button.primary{background:var(--primary);color:var(--on-primary)}
button.plain{background:transparent;color:var(--primary)}
button.danger{background:var(--warn-soft);color:var(--warn)}
button.small,button.small:not([size=mini]){width:auto;max-width:100%;min-height:72rpx;padding:12rpx 28rpx;font-size:30rpx;font-weight:500;line-height:1.3;border-radius:36rpx;margin:16rpx 0}
button .ic{width:40rpx;height:40rpx}
button[disabled]:not([type]){opacity:.45;background:var(--primary-soft);color:var(--primary)}
button.primary[disabled]:not([type]){background:var(--primary);color:var(--on-primary)}
button.plain[disabled]:not([type]){background:transparent}
button.danger[disabled]:not([type]){background:var(--warn-soft);color:var(--warn)}
.button-hover{opacity:.7}

/* 表单 */
input,textarea{box-sizing:border-box;width:100%;font-family:inherit;font-size:34rpx;line-height:1.41;color:var(--text);background:transparent}
input{height:96rpx;min-height:96rpx}
textarea{width:100%;height:280rpx;padding:0;font-family:var(--serif);font-size:32rpx;line-height:52rpx}
.input-placeholder,.textarea-placeholder{color:var(--mute)}
picker{display:block}
radio-group{display:block}
label{display:flex;align-items:center}
.screen .wx-radio-input:not(.wx-radio-input-checked){border-color:var(--mute)!important;background-color:transparent!important}
.screen .wx-switch-input:not(.wx-switch-input-checked){background-color:var(--fill)!important;border-color:transparent!important}
.screen .wx-switch-input::before{background-color:transparent!important}
switch{flex:none}
image{display:block;border-radius:20rpx;width:100%;height:360rpx}
/* iOS 风格方形缩略图：连续圆角、aspectFill、细描边（深色模式下避免与卡片融成一片） */
.thumb{position:relative;flex:none;box-sizing:border-box;width:128rpx;height:128rpx;border-radius:18rpx;overflow:hidden;background:var(--fill)}
.thumb.thumb-lg{width:128rpx;height:128rpx}
.thumb image{display:block;width:100%;height:100%;border-radius:0}
.thumb::after{content:'';position:absolute;left:0;top:0;right:0;bottom:0;border-radius:inherit;border:1px solid var(--line);pointer-events:none}
.thumb-wrap{position:relative;flex:none}
.thumb-badge{position:absolute;top:-12rpx;right:-12rpx;width:44rpx;height:44rpx;border-radius:22rpx;background:#636366;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 4rpx var(--card)}
.light .thumb-badge{background:#8E8E93}
.thumb-badge::before{content:'';position:absolute;left:-20rpx;right:-20rpx;top:-20rpx;bottom:-20rpx}
.thumb-badge-x{width:24rpx;height:24rpx;background-color:#fff;transform:rotate(45deg)}

/* 胶囊筛选（36pt） */
.chip-bar{width:auto;margin:32rpx -32rpx;white-space:nowrap}
.chip-row{display:inline-flex;gap:16rpx;padding:0 var(--gutter)}
.chips{display:flex;flex-wrap:wrap;gap:16rpx;margin:0}
.chip{box-sizing:border-box;flex:none;display:inline-flex;align-items:center;justify-content:center;height:72rpx;padding:0 32rpx;border-radius:36rpx;background:var(--fill);color:var(--text);font-size:30rpx;font-weight:500;white-space:nowrap}
.chip.chosen,.chosen{background:var(--primary);color:var(--on-primary);font-weight:600}
.tag{display:inline-flex;align-items:center;font-size:26rpx;line-height:36rpx;padding:6rpx 20rpx;border-radius:14rpx;background:var(--primary-soft);color:var(--primary);font-weight:500}
.badge{display:inline-flex;align-items:center;font-size:24rpx;font-weight:600;line-height:32rpx;padding:4rpx 18rpx;border-radius:14rpx;background:var(--warn-soft);color:var(--warn)}

/* 其他 */
.row{display:flex;gap:24rpx;align-items:center;justify-content:space-between}
.row view,.row text{min-width:0}
.glow{position:fixed;left:0;top:0;right:0;bottom:0;pointer-events:none;background:radial-gradient(ellipse,rgba(190,126,49,.3),transparent 70%);animation:fadeout .6s forwards}
@keyframes fade{from{opacity:0}to{opacity:1}}@keyframes fadeout{from{opacity:1}to{opacity:0}}
canvas{width:320px;max-width:100%;height:680px}
/* v3 icon set: monochrome SVG masks, tinted by background-color (follows theme variables) */
.ic{display:inline-block;flex:none;width:40rpx;height:40rpx;background-color:currentColor;-webkit-mask-size:contain;mask-size:contain;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center}
.ic-journal{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-journal-f{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-wind{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-wind-f{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-glass{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-glass-f{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-gear{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-gear-f{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-lock{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-globe{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-pen{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-chev{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-star{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-moon{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-eye{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-bell{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-card{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-doc{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-trash{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-dots{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-plus{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
/* 广场翻页提示：淡入后缓慢淡入淡出（仅透明度变化） */
.page-loading{justify-content:center;color:var(--mute);animation:fade .3s ease both,breathe 1.6s ease-in-out .3s infinite alternate}
@keyframes breathe{from{opacity:1}to{opacity:.35}}

.ic-stack{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}

/* 赞 / 评论 / 转发 图标 */
.ic-heart{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-heart-fill{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-comment{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-share{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.ic-person{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
/* 头像：圆形，未设置时为浅色占位 + 人形图标 */
.avatar{display:inline-flex;align-items:center;justify-content:center;flex:none;border-radius:50%;overflow:hidden;background:var(--fill);color:var(--mute)}
.avatar image,image.avatar{display:block}
.avatar .ic{width:60%;height:60%;background-color:currentColor}
/* 设置页顶部的个人资料卡（类似 iOS 设置的 Apple ID 行） */
.pf-cell-group{margin-top:24rpx}
.pf-cell{min-height:152rpx;gap:24rpx}
.pf-cell-avatar{width:112rpx;height:112rpx}
.pf-cell-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx;padding:24rpx 0}
.pf-cell-name{font-size:36rpx;font-weight:600;line-height:46rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pf-cell-sub{font-size:26rpx;line-height:36rpx;color:var(--mute)}

/* Approved premium v2: real controls and live data, no screenshot skins. */
.shell,.screen{--bg:#110E0F;--card:#241C18;--card2:#30261F;--fill:rgba(196,160,96,.09);--line:rgba(232,201,154,.13);--sep:rgba(196,160,100,.20);--text:#F2E8DC;--sub:#B6A38E;--mute:#968777;--primary:#C4A060;--primary-soft:rgba(196,160,96,.16);--on-primary:#2A1C10;--bar:rgba(17,14,15,.96);--gold-soft:#E8C99A;--btn-top:#E6C48C;--btn-mid:#C9A05E;--btn-bottom:#A78440;--card-top:rgba(59,46,33,.36);--shadow:rgba(0,0,0,.20)}
.shell.light,.screen.light{--bg:#F3EBE0;--card:#FFFBF5;--card2:#EFE6D8;--fill:rgba(166,124,58,.08);--line:rgba(120,80,40,.13);--sep:rgba(150,110,55,.26);--text:#2C241C;--sub:#7A6C60;--mute:#897B6E;--primary:#A67C3A;--primary-soft:rgba(166,124,58,.12);--on-primary:#2A1C10;--bar:rgba(247,241,232,.96);--gold-soft:#78572C;--card-top:rgba(255,255,255,.8);--shadow:rgba(80,50,20,.06)}
.screen{padding-top:20rpx}.screen.tab-screen{padding-bottom:calc(100rpx + 49px + env(safe-area-inset-bottom))}.large-title,.title{font-family:var(--serif);font-weight:500;color:var(--gold-soft);letter-spacing:2rpx;font-size:60rpx;line-height:80rpx}.large-sub,.tagline{font-size:25rpx;line-height:38rpx;padding-top:10rpx}.headline,.title3{font-family:var(--serif);color:var(--gold-soft)}.section-header{margin:32rpx 8rpx 16rpx;color:var(--sub)}.section-footer{margin:16rpx 8rpx 0;font-size:24rpx;line-height:38rpx}.center-footer{font-size:22rpx;margin:40rpx 8rpx 20rpx;line-height:36rpx}.card,.group{border:1rpx solid var(--sep);background:linear-gradient(135deg,var(--card-top),transparent 70%),var(--card);border-radius:26rpx;box-shadow:0 8rpx 28rpx var(--shadow)}.card{padding:28rpx;margin-bottom:24rpx}.group .cell{min-height:96rpx}.group .cell-label{font-size:29rpx}.group .cell-value{font-size:26rpx}.tile{background:var(--primary-soft);color:var(--primary);border-radius:16rpx}.tile .ic{background-color:var(--primary)}.avatar{background:linear-gradient(140deg,#E8C99A,#A78440);color:var(--on-primary)}
button.primary,.primary{background:linear-gradient(180deg,var(--btn-top),var(--btn-mid) 53%,var(--btn-bottom));color:var(--on-primary);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.35),0 6rpx 20rpx var(--shadow);border-radius:40rpx;font-weight:600;min-height:84rpx;font-size:29rpx}.primary[disabled]{opacity:.5}button.small{min-height:60rpx;padding:0 24rpx;font-size:25rpx;line-height:60rpx;border-radius:32rpx}.chip{background:var(--fill);border:1rpx solid var(--line);color:var(--sub);font-size:24rpx;line-height:38rpx;padding:8rpx 20rpx}.chip.chosen{background:linear-gradient(180deg,var(--btn-top),var(--btn-bottom));color:var(--on-primary);border-color:transparent}.chip-bar{max-width:100%;overflow:visible;white-space:normal}.chip-row{display:flex;flex-wrap:wrap;gap:12rpx;max-width:100%;width:auto;white-space:normal}.chip-row .chip{margin:0;flex:none}.tag{font-size:23rpx;background:var(--primary-soft);color:var(--primary);border-radius:12rpx}.badge{border:1rpx solid var(--sep);color:var(--primary);background:var(--fill)}
.screen input,.screen textarea{color:var(--text)}.screen .group input,.screen .group textarea,.screen .rt-form input,.screen .rt-form textarea{background:var(--fill);border:1rpx solid var(--sep);border-radius:16rpx;box-sizing:border-box}.screen textarea{line-height:1.6}.screen .stats{gap:12rpx;margin:20rpx 0 28rpx}.screen .stat{border:1rpx solid var(--sep);border-radius:20rpx;background:linear-gradient(135deg,var(--card-top),transparent),var(--card);padding:18rpx 8rpx}.screen .stat-num{font-family:var(--serif);color:var(--gold-soft);font-size:40rpx}.screen .stat-label{font-size:22rpx}.screen .home-write{margin-top:24rpx;border-radius:40rpx}.screen .home-write .ic{background-color:var(--on-primary)}
.rt-segments{border:1rpx solid var(--sep);background:var(--fill);border-radius:44rpx;padding:5rpx}.rt-segments text{border-radius:38rpx;color:var(--sub)}.rt-segments .on{background:linear-gradient(180deg,var(--btn-top),var(--btn-bottom));color:var(--on-primary);box-shadow:0 4rpx 12rpx var(--shadow)}
@media(max-width:350px){.screen{--gutter:26rpx}.large-title,.title{font-size:56rpx}.screen .section-footer{font-size:23rpx}.premium-plaza-copy .large-title{font-size:60rpx}.premium-plaza-hero{margin-left:-26rpx;margin-right:-26rpx}.chip-row{gap:10rpx}.chip{padding:6rpx 16rpx}.screen.tab-screen{padding-bottom:calc(120rpx + 49px + env(safe-area-inset-bottom))}}
.screen .stats{background:transparent;padding:0;border-radius:0}.screen .stat+.stat::before{display:none}.screen .stat-word{font-size:29rpx;max-width:100%;overflow:hidden;text-overflow:ellipsis}.screen .rt-segments text.on{background:linear-gradient(180deg,var(--btn-top),var(--btn-bottom));color:var(--on-primary)}

/* t128: shared photographic layer; preblurred non-UI local crop, fixed and non-interactive. */
.screen{position:relative;z-index:0;isolation:isolate;--photo-top:rgba(17,14,15,.83);--photo-mid:rgba(17,14,15,.90);--photo-bottom:rgba(17,14,15,.97);--bubble-own:#3A2E22;--sub:#C2AE97;--mute:#AD9B87}
.screen.light{--photo-top:rgba(243,235,224,.91);--photo-mid:rgba(243,235,224,.95);--photo-bottom:rgba(243,235,224,.98);--bubble-own:#E8D5B0;--sub:#7A6C60;--mute:#897B6E}
.screen::before{content:'';position:fixed;left:0;right:0;top:0;bottom:0;pointer-events:none;z-index:-1;background-image:linear-gradient(180deg,var(--photo-top),var(--photo-mid) 58%,var(--photo-bottom)),url("data:image/jpeg;base64,");background-size:cover;background-position:62% center;background-repeat:no-repeat}

/* t129: visible photographic title regions, not just the dim full-screen layer. */



