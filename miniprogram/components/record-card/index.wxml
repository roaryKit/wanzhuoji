<view class="card rc" bindtap="open" bindlongpress="share"><view class="rc-top"><view wx:if="{{plaza}}" class="rc-author"><image wx:if="{{record.author.avatar&&!avatarFailed}}" class="avatar rc-avatar" src="{{record.author.avatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="avatar rc-avatar rc-avatar-label"><text>{{record.author.avatarState==='pending'?'待审':record.author.avatarState==='anonymous'?'匿':record.author.name?record.author.name[0]:'友'}}</text></view><text class="rc-author-name">{{record.author.name||copy.stranger}}</text></view><view wx:else class="rc-author"><image wx:if="{{me.avatarURL}}" class="avatar rc-avatar" src="{{me.avatarURL}}" mode="aspectFill"/><view wx:else class="avatar rc-avatar"><view class="ic ic-person"/></view><text class="rc-author-name">{{me.nickname||copy.selfName}}</text></view><view wx:if="{{plaza}}" class="rc-dots" catchtap="report"><view class="ic ic-dots rc-dots-icon"/></view><text wx:elif="{{record.category}}" class="foot">{{record.category}}</text></view><view class="rc-name"><text class="rc-title">{{record.wineName}}</text><text wx:if="{{record.abv!==null && record.abv!==undefined && record.abv!==''}}" class="rc-abv">{{record.abv}}°</text></view><view wx:if="{{record.tagList.length}}" class="rc-tags"><text wx:for="{{record.tagList}}" wx:key="*this" class="tag">{{item}}</text></view><view class="rc-body {{photosOpen?'rc-body-open':''}}"><view class="rc-main"><view wx:if="{{record.text}}" class="record-text {{expanded?'':'clamp'}}">{{record.text}}</view><view class="full-measure">{{record.text}}</view></view><view wx:if="{{record.thumbs.length}}" class="rc-photos"><photo-stack urls="{{record.thumbs}}" mode="card" bind:toggle="photos"/></view></view><view wx:if="{{!plaza && record.privacy==='public' && record.auditStatus!=='pass'}}" class="rc-audit"><text class="badge">{{record.auditStatus==='reject'?copy.auditReject:copy.auditPending}}</text><text wx:if="{{record.auditReason}}" class="foot">{{record.auditReason}}</text></view><view class="rc-foot"><block wx:if="{{plaza}}"><text class="foot rc-foot-date">{{record.dateLabel}}</text><view class="rc-acts"><view class="rc-act {{record.liked?'on':''}}" catchtap="like"><view class="ic ic-{{record.liked?'heart-fill':'heart'}} rc-act-ic"/><text class="rc-act-n">{{record.likeCount||copy.like}}</text></view><view class="rc-act" catchtap="comment"><view class="ic ic-comment rc-act-ic"/><text class="rc-act-n">{{record.commentCount||copy.comment}}</text></view><button class="rc-act rc-share" open-type="share" data-id="{{record._id}}" data-title="{{record.wineName}}" data-image="{{record.thumbs[0]||''}}" catchtap="noop"><view class="ic ic-share rc-act-ic"/><text class="rc-act-n">{{copy.share}}</text></button></view></block><block wx:else><text class="foot rc-foot-date">{{record.dateLabel}}{{record.place?' · '+record.place:''}}</text><view class="rc-priv"><view class="ic ic-{{record.privacy==='private'?'lock':'globe'}} rc-priv-icon"/><text>{{record.privacy==='private'?copy.privateLabel:copy.publicLabel}}</text></view><text wx:if="{{overflow}}" class="expand-control" catchtap="expand">{{expanded?copy.collapse:copy.expand}}</text></block></view></view>
