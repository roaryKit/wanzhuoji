<import src="../../templates/main-top.wxml"/>
<view class="screen tab-screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="premium-plaza-hero premium-page-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="large-title">{{copy.tabHome}}</view><text class="tagline">{{copy.slogan}}</text></view></view><view class="main-sticky"><view class="compact-row"><template is="compactTitle" data="{{label:copy.tabHome}}"/><button class="compact-action" data-url="/pages/record-edit/index" bindtap="go">{{copy.writeTitle}}</button></view></view><button class="primary home-write" data-url="/pages/record-edit/index" bindtap="go"><view class="ic ic-pen"/><text>{{copy.writeTitle}}</text></button><view class="stats"><view class="stat"><view class="stat-num accent">{{stats.count||0}}<text class="stat-unit">{{copy.unitTimes}}</text></view><text class="stat-label">{{copy.statCount}}</text></view><view class="stat"><view class="stat-num">{{stats.nights||0}}<text class="stat-unit">{{copy.unitNights}}</text></view><text class="stat-label">{{copy.statNights}}</text></view><view class="stat"><view class="stat-num stat-word">{{stats.tag||'—'}}</view><text class="stat-label">{{copy.statTag}}</text></view></view><view class="section-header"><text>{{copy.recentPrefix}}{{stats.latest||'—'}}</text><text wx:if="{{rows.length}}" class="accent">{{copy.longPressHint}}</text></view><view wx:if="{{busy || (loading && !rows.length)}}" class="sub loading">{{copy.readingRecords}}</view><view wx:if="{{!busy && !loading && !error && !rows.length}}" class="empty">{{copy.empty}}</view><button wx:if="{{error}}" bindtap="retry">{{copy.retry}}</button><view wx:for="{{rows}}" wx:key="_id" class="feed-anchor" data-id="{{item._id}}"><record-card record="{{item}}" me="{{me}}" bind:open="open" bind:export="export"/></view><view wx:if="{{loading && rows.length}}" class="sub loading">{{copy.loading}}</view><view class="foot more-hint" wx:if="{{more && rows.length && !loading}}">{{copy.pullMore}}</view></block></view>
