.home-write{margin:36rpx 0 0}
.stats{display:flex;margin-top:36rpx;padding:32rpx 0;background:var(--card);border-radius:28rpx}
.stat{position:relative;flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 12rpx}
.stat+.stat::before{content:'';position:absolute;left:0;top:12rpx;bottom:12rpx;width:1px;background:var(--sep);transform:scaleX(.5)}
.stat-num{font-size:56rpx;font-weight:700;line-height:68rpx;color:var(--text);white-space:nowrap}
.stat-num.accent{color:var(--primary)}
.stat-unit{font-size:30rpx;font-weight:500;color:var(--sub);margin-left:4rpx}
.stat-word{max-width:100%;font-size:40rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis}
.stat-label{font-size:26rpx;line-height:36rpx;color:var(--mute)}
.section-header text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.more-hint{display:block;text-align:center;padding:16rpx 0}
