<view class="ps-root"><view wx:if="{{count===1}}" class="ps-single ps-single-{{mode}}" data-index="0" catchtap="tapItem"><image lazy-load="{{true}}" class="ps-img" src="{{items[0].url}}" mode="aspectFill"/></view><block wx:elif="{{count>1}}"><view class="ps ps-{{mode}} {{open?'ps-open':''}}" style="{{box}}" catchtap="toggle"><view wx:for="{{items}}" wx:key="url" class="ps-item" style="{{item.style}}" data-index="{{index}}" catchtap="tapItem"><image lazy-load="{{true}}" class="ps-img" src="{{item.url}}" mode="aspectFill"/><view wx:if="{{!open && index===0}}" class="ps-count"><view class="ic ic-stack ps-count-ic"/><text>{{count}}</text></view></view></view><view wx:if="{{open}}" class="ps-toggle" catchtap="toggle"><text>{{copy.collapse}}</text></view></block></view>
