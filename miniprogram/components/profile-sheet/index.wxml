<view wx:if="{{show}}" class="ps-mask" catchtap="skip" catchtouchmove="noop"><view class="ps-sheet" catchtap="noop"><view class="ps-grabber"/><view class="ps-title">{{copy.sheetTitle}}</view><view class="ps-sub">{{copy.sheetSub}}</view><button class="ps-avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{avatar}}" class="avatar ps-avatar" src="{{avatar}}" mode="aspectFill"/><view wx:else class="avatar ps-avatar"><view class="ic ic-person"/></view><text class="ps-avatar-tip">{{copy.changeAvatar}}</text></button><view class="ps-field"><input type="nickname" class="ps-input" value="{{nickname}}" placeholder="{{copy.nicknamePlaceholder}}" placeholder-class="ps-ph" maxlength="16" bindinput="onNick" bindblur="onNick"/></view><button class="primary ps-save" disabled="{{busy}}" bindtap="save">{{copy.save}}</button><view class="ps-skip" bindtap="skip">{{copy.skip}}</view></view></view>
