.rt-search{display:flex;align-items:center;gap:16rpx;margin-top:24rpx}.rt-search input{flex:1;min-width:0;background:var(--fill);padding:0 20rpx;border-radius:20rpx;height:80rpx;min-height:80rpx;font-size:28rpx}.rt-search .small{font-size:24rpx;max-width:160rpx;white-space:nowrap;padding:0 16rpx}.rt-table-interest{margin:16rpx 0}.rt-table-intro{font-size:28rpx;line-height:44rpx;margin-bottom:16rpx}.rt-mine{margin-bottom:12rpx}

.rt-mine{display:flex;align-items:center;gap:20rpx;padding:20rpx}.rt-summary{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}.rt-summary .headline{font-size:29rpx}.rt-summary .foot{font-size:22rpx}.rt-mine>.accent{font-size:24rpx;white-space:nowrap}.rt-discover-preview{display:flex;align-items:center;gap:22rpx;margin-bottom:20rpx}.rt-thumb{width:184rpx;height:150rpx;flex-shrink:0;position:relative}.rt-thumb-table{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:76rpx;height:76rpx;border-radius:50%;background:radial-gradient(circle at 35% 30%,#d8b286,#a8794f);border:5rpx solid #795333;box-shadow:0 0 0 5rpx rgba(196,151,104,.16);display:flex;align-items:center;justify-content:center;color:#fff0d9;font-size:20rpx}.rt-thumb-seat{position:absolute;width:24rpx;height:24rpx;border-radius:50%;transform:translate(-50%,-50%);background:#72695e;display:flex;align-items:center;justify-content:center;font-size:13rpx;color:#d8c6ab;overflow:hidden}.rt-thumb-seat image{width:100%;height:100%}.rt-thumb-seat.is-empty{background:transparent;border:1px dashed var(--secondary);color:var(--secondary)}.rt-thumb-person{width:12rpx;height:12rpx;background:#e3cfb4;border-radius:50%;box-shadow:0 10rpx 0 4rpx #e3cfb4;transform:translateY(-4rpx)}

.rt-card-main{display:flex;align-items:center;gap:20rpx}.rt-card-main>.rt-summary{align-self:stretch;justify-content:center}.rt-summary .headline{overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.rt-summary .foot{line-height:1.5;overflow-wrap:anywhere}.rt-summary .rt-table-intro{font-size:25rpx;line-height:38rpx;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}.rt-card-footer{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-top:24rpx}.rt-card-footer .small{margin:0;flex-shrink:0;min-width:136rpx}.rt-enter{font-size:24rpx;margin-top:2rpx}.rt-table-card .rt-thumb{align-self:center}

.rt-search input{border:1rpx solid var(--sep);border-radius:40rpx;background:var(--fill);height:66rpx;min-height:66rpx;font-size:25rpx}.rt-search{gap:12rpx;margin-top:18rpx}.rt-search .small{min-height:64rpx;line-height:64rpx}.rt-thumb{width:316rpx;height:316rpx;flex:0 0 316rpx}.rt-thumb-seat{width:72rpx;height:72rpx;box-sizing:border-box;border:2rpx solid rgba(232,201,154,.38);background:linear-gradient(140deg,#E8C99A,#A78440);box-shadow:0 4rpx 12rpx rgba(0,0,0,.25);font-size:24rpx}.rt-thumb-person{width:27rpx;height:27rpx;box-shadow:0 22rpx 0 10rpx #e3cfb4;transform:translateY(-10rpx)}.rt-thumb-seat.is-empty{border:2rpx dashed var(--primary);box-shadow:none;background:transparent;color:var(--primary)}.rt-thumb-table{width:104rpx;height:104rpx;font-family:var(--serif);font-size:26rpx;border:4rpx solid #795333;box-shadow:0 0 30rpx var(--primary-soft),inset 0 0 12rpx #6e482b;background:radial-gradient(circle at 32% 30%,#B98C52,#87592D 68%,#59381D)}.rt-mine,.rt-table-card{padding:22rpx;border:1rpx solid var(--sep);border-radius:26rpx;background:linear-gradient(135deg,var(--card-top),transparent 70%),var(--card);margin-bottom:26rpx;box-shadow:0 8rpx 24rpx var(--shadow)}.rt-card-main,.rt-mine{gap:14rpx;align-items:center}.rt-summary{gap:10rpx}.rt-summary .headline{font-family:var(--serif);font-size:31rpx;color:var(--gold-soft);line-height:44rpx;font-weight:500}.rt-summary .foot{font-size:22rpx;line-height:34rpx}.rt-summary .rt-table-intro{font-size:25rpx;line-height:38rpx;-webkit-line-clamp:3;color:var(--text)}.rt-summary .small{align-self:flex-start;max-width:100%;min-width:0;margin:4rpx 0 0;padding:0 20rpx;white-space:normal;font-size:24rpx;line-height:56rpx;min-height:56rpx}.rt-enter{display:flex;align-items:center;justify-content:center;align-self:flex-start;padding:0 22rpx;min-height:56rpx;line-height:1.3;border-radius:30rpx;background:linear-gradient(180deg,var(--btn-top),var(--btn-bottom));color:var(--on-primary);font-size:24rpx}.rt-discovery{padding-bottom:32rpx}.rt-discovery .chip-bar{overflow:visible}.rt-discovery .chip-row{flex-wrap:wrap;max-width:100%;gap:12rpx;white-space:normal}.rt-discovery .section-header{margin:28rpx 4rpx 14rpx}.rt-card-footer{display:none}@media(max-width:350px){.rt-thumb{width:290rpx;height:290rpx;flex-basis:290rpx}.rt-thumb-seat{width:66rpx;height:66rpx}.rt-mine,.rt-table-card{padding:18rpx}.rt-summary .headline{font-size:29rpx}.rt-summary .foot{font-size:21rpx}.rt-summary .rt-table-intro{font-size:24rpx;line-height:36rpx}.rt-card-main,.rt-mine{gap:10rpx}.rt-summary .small,.rt-enter{font-size:23rpx;padding-left:16rpx;padding-right:16rpx}}

/* Scope the hit target above decorative seats; no full-card overlay intercepts it. */
.rt-apply-button{position:relative;z-index:1}.rt-thumb{pointer-events:none}.rt-apply-feedback{font-size:22rpx;line-height:32rpx;color:var(--sub);word-break:break-all;white-space:normal;margin:8rpx 0 16rpx}

.rt-summary button.rt-manage{position:relative;z-index:1;white-space:normal;height:auto;min-height:64rpx;line-height:36rpx;padding:12rpx 16rpx;max-width:100%;font-size:24rpx}.rt-request-count{color:var(--warn);font-weight:600}.rt-create-inline{padding:12rpx 0 12rpx 16rpx}
