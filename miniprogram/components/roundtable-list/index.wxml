<template name="rtThumb"><view class="rt-thumb"><view class="rt-thumb-table"><text>{{table.count}}/{{table.capacity||8}}</text></view><view wx:for="{{table.seats}}" wx:for-item="seat" wx:key="key" class="rt-thumb-seat {{seat.empty?'is-empty':''}}" style="left:{{seat.tx}}%;top:{{seat.ty}}%"><image wx:if="{{seat.avatar}}" src="{{seat.avatar}}" mode="aspectFill"/><text wx:else>{{seat.empty?'+':seat.name?'':'●'}}</text><view wx:if="{{!seat.avatar&&!seat.empty&&seat.name}}" class="rt-thumb-person"/></view></view></template><view class="rt-discovery"><view class="rt-search"><input value="{{search}}" bindinput="draft" bindconfirm="search" placeholder="{{copy.rtSearch}}" confirm-type="search"/><button class="small" bindtap="search">{{copy.rtSearchAction}}</button></view><scroll-view scroll-x class="chip-bar"><view class="chip-row"><text wx:for="{{filters}}" wx:key="*this" class="chip {{interest===item?'chosen':''}}" data-tag="{{item}}" bindtap="filter">{{item}}</text></view></scroll-view><view class="section-footer">{{copy.rtJoinLimit}}</view><view wx:if="{{mine.length}}" class="section-header">{{copy.rtMy}}</view><view wx:for="{{mine}}" wx:key="id" class="rt-mine cell group" data-id="{{item.id}}" bindtap="open"><view class="rt-summary"><text class="headline">{{item.name}}</text><text class="foot">{{item.count}} / {{item.capacity||8}} · {{copy.rtOnlyMembers}}</text><text class="accent rt-enter">{{copy.rtChat}} ›</text><button wx:if="{{item.owner}}" class="small rt-manage" data-id="{{item.id}}" catchtap="manage">{{copy.rtManageClose}} <text wx:if="{{item.pendingCount>0}}" class="rt-request-count">{{copy.rtReviewLabel}} {{item.pendingCount}}</text></button></view><template is="rtThumb" data="{{table:item}}"/></view><view class="section-header"><text>{{copy.rtFind}}</text><text class="accent rt-create-inline" bindtap="create">{{copy.rtCreateFixed}}</text></view><view wx:for="{{rows}}" wx:key="id" class="card rt-table-card" data-id="{{item.id}}" bindtap="open"><view class="rt-card-main"><view class="rt-summary"><text class="headline">{{item.name}}</text><text class="foot">{{item.count}} / {{item.capacity||8}} · {{item.interest}}</text><text class="rt-table-intro sub">{{item.intro}}</text><text class="foot">{{item.formed?copy.rtFormed:copy.rtWaiting}}</text><button wx:if="{{item.owner}}" class="small rt-manage" data-id="{{item.id}}" catchtap="manage">{{copy.rtManageClose}} <text wx:if="{{item.pendingCount>0}}">· {{copy.rtReviewLabel}} {{item.pendingCount}}</text></button><button class="small rt-apply-button {{item.full&&!item.joined?'':'primary'}}" data-id="{{item.id}}" catchtap="apply" loading="{{applyingId===item.id}}" disabled="{{!!applyingId}}">{{applyingId===item.id?'提交中…':item.joined?copy.rtChat:item.requestStatus==='pending'?copy.rtPending:item.full?copy.rtFull:copy.rtApply}}</button><view wx:if="{{applyFeedbackId===item.id && applyFeedback}}" class="rt-apply-feedback">{{applyFeedback}}</view><view wx:elif="{{item.requestStatus==='pending'}}" class="rt-apply-feedback">{{copy.rtApplied}}</view></view><template is="rtThumb" data="{{table:item}}"/></view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!rows.length&&!loading}}" class="empty">{{copy.rtNoRows}}</view><button wx:if="{{more}}" bindtap="load" disabled="{{loading}}">{{loading?copy.loading:copy.rtMore}}</button></view>
