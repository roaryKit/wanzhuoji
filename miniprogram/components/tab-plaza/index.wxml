<import src="../../templates/main-top.wxml"/>
<view class="screen tab-screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="retry">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="premium-plaza-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="large-title">{{copy.tabPlaza}}</view><text class="large-sub">{{copy.plaza}}</text></view></view><view class="plaza-sticky main-sticky"><template is="compactTitle" data="{{label:copy.tabPlaza}}"/><view class="rt-segments"><text class="rt-segment {{section!=='roundtable'?'on':''}}" data-section="plaza" bindtap="switchSection">{{copy.rtPlaza}}</text><text class="rt-segment {{section==='roundtable'?'on':''}}" data-section="roundtable" bindtap="switchSection">{{copy.rtTab}}</text></view><view wx:if="{{section==='roundtable'}}" class="rt-quick-actions"><button class="small primary rt-create-fixed" bindtap="createRoundtable" aria-disabled="{{tableQuota>=3}}">{{tableQuota>=3?'已加入3/3桌':'＋ 创建圆桌'}}</button><button wx:if="{{ownedPending>0}}" class="small rt-review-fixed" bindtap="reviewRoundtable">{{copy.rtReviewLabel}} <text class="rt-pending-badge">{{ownedPending}}</text> ›</button><text wx:else class="foot">{{copy.rtQuotaSmall}}</text></view></view><view class="plaza-roundtable-section" wx:if="{{roundtableVisited}}" hidden="{{section!=='roundtable'}}"><roundtable-list active="{{active && section==='roundtable'}}" id="roundtable-list" bind:status="roundtableStatus" theme="{{theme}}" authorized="{{authorized}}"/></view><view class="plaza-records-section" hidden="{{section==='roundtable'}}"><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chip-bar"><view class="chip-row"><text wx:for="{{filters}}" wx:key="*this" class="chip {{filter===item?'chosen':''}}" data-tag="{{item}}" bindtap="select">{{item}}</text></view></scroll-view><view wx:for="{{rows}}" wx:key="_id" class="feed-anchor" data-id="{{item._id}}"><record-card record="{{item}}" plaza="{{true}}" bind:report="report" bind:like="like"/></view><view wx:if="{{loading}}" class="sub loading page-loading">{{copy.loading}}</view><view wx:if="{{!loading && !error && !rows.length}}" class="empty">{{copy.plazaEmpty}}</view></view></block><profile-sheet id="profile-sheet"/></view>
