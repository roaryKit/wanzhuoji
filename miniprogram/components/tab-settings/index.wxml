<import src="../../templates/main-top.wxml"/>
<view class="screen tab-screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="retry">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="premium-plaza-hero premium-page-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="large-title">{{copy.tabSettings}}</view><text class="large-sub">{{copy.groupAppearance}} · {{copy.groupPrivacy}}</text></view></view><view class="main-sticky"><view class="compact-row"><template is="compactTitle" data="{{label:copy.tabSettings}}"/><button class="compact-action" data-url="/pages/profile/index" bindtap="go">{{copy.profileTitle}}</button></view></view><view class="group tiles pf-cell-group"><view class="cell pf-cell" hover-class="cell-hover" data-url="/pages/profile/index" bindtap="go"><image wx:if="{{profile.avatarURL}}" class="avatar pf-cell-avatar" src="{{profile.avatarURL}}" mode="aspectFill"/><view wx:else class="avatar pf-cell-avatar"><view class="ic ic-person"/></view><view class="pf-cell-main"><text class="pf-cell-name">{{profile.nickname||copy.profileUnset}}</text><text class="pf-cell-sub">{{copy.profileSub}}</text></view><view class="ic ic-chev chev"/></view></view><view class="section-header">{{copy.groupAppearance}}</view><view class="group tiles"><view class="cell" hover-class="cell-hover" bindtap="chooseTheme"><view class="tile"><view class="ic ic-moon"/></view><text class="cell-label">{{copy.themeRow}}</text><text class="cell-value">{{themeLabel}}</text><view class="ic ic-chev chev"/></view></view><text class="section-footer">{{copy.themeFooter}}</text><view class="section-header">{{copy.groupPrivacy}}</view><view class="group tiles"><label class="cell"><view class="tile"><view class="ic ic-eye"/></view><text class="cell-label">{{copy.defaultPublic}}</text><switch color="{{theme==='light'?'#A67C3A':'#C4A060'}}" disabled="{{busy}}" checked="{{user.defaultPrivacy==='public'}}" data-key="defaultPrivacy" bindchange="setting"/></label></view><text class="section-footer">{{copy.defaultPublicFooter}}</text><view class="section-header">{{copy.groupReminder}}</view><view class="group tiles"><label class="cell"><view class="tile"><view class="ic ic-bell"/></view><text class="cell-label">{{copy.reminderRow}}</text><switch color="{{theme==='light'?'#A67C3A':'#C4A060'}}" disabled="{{busy}}" checked="{{user.reminderOn}}" data-key="reminderOn" bindchange="setting"/></label></view><text class="section-footer">{{copy.reminderFooter}}</text><view class="section-header">{{copy.groupData}}</view><view class="group tiles"><view class="cell" hover-class="cell-hover" data-url="/pages/export/index" bindtap="go"><view class="tile"><view class="ic ic-card"/></view><text class="cell-label">{{copy.exportRow}}</text><view class="ic ic-chev chev"/></view><view class="cell {{busy?'cell-disabled':''}}" hover-class="{{busy?'none':'cell-hover'}}" bindtap="clear"><view class="tile warn-tile"><view class="ic ic-trash"/></view><text class="cell-label warn">{{copy.clearRow}}</text></view></view><view class="section-header">{{copy.groupAbout}}</view><view class="group tiles"><view class="cell" hover-class="cell-hover" data-url="/pages/legal/index" bindtap="go"><view class="tile"><view class="ic ic-doc"/></view><view class="cell-label">{{copy.legalRow}}<text class="cell-note">{{copy.legalNote}}</text></view><view class="ic ic-chev chev"/></view></view><text class="center-footer">{{copy.footer}}</text></block></view>
