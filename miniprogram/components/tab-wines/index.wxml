<import src="../../templates/main-top.wxml"/>
<view class="screen tab-screen {{theme}}"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="retry">{{copy.retry}}</button><view wx:if="{{busy}}" class="sub loading">{{copy.reading}}</view><view wx:if="{{!authorized && !error}}" class="sub loading">{{copy.initializing}}</view><block wx:if="{{authorized}}"><view class="premium-plaza-hero premium-page-hero"><image class="premium-plaza-photo" src="/assets/premium/plaza-still.jpg" mode="aspectFit"/><view class="premium-plaza-shade"/><view class="premium-plaza-copy"><view class="large-title">{{copy.tabWines}}</view><text class="large-sub">{{copy.winesCountPrefix}}{{total}}{{copy.winesCountSuffix}}</text></view></view><view class="main-sticky"><view class="compact-row"><template is="compactTitle" data="{{label:copy.tabWines}}"/></view><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chip-bar"><view class="chip-row"><text class="chip {{filter===item?'chosen':''}}" wx:for="{{filters}}" wx:key="*this" data-value="{{item}}" bindtap="filter">{{item}}</text></view></scroll-view></view><view wx:if="{{rows.length}}" class="group wine-group"><wine-card wx:for="{{rows}}" wx:key="_id" wine="{{item}}" first="{{index===0}}" bind:open="open"/></view><text wx:if="{{rows.length}}" class="section-footer">{{copy.winesHint}}</text><text wx:if="{{!busy && !error && !rows.length}}" class="empty">{{copy.winesEmpty}}</text></block></view>
