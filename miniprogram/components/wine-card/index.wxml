<view class="wine-row {{first?'':'wine-sep'}}" hover-class="wine-hover" bindtap="open"><view class="wine-tile">{{wine.initial}}</view><view class="wine-main"><view class="wine-name">{{wine.name}}</view><view class="wine-meta"><view wx:for="{{wine.stars}}" wx:key="index" class="ic ic-star wine-star {{item?'on':''}}"/><text class="wine-info">{{wine.category}} · {{wine.rating||0}} / 5</text></view></view><view class="wine-count"><text class="wine-count-num">{{wine.count||0}}</text>{{copy.unitTimes}}</view><view class="ic ic-chev wine-chev"/></view>
