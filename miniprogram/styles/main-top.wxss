/* t135: one native-page scroll root; every tab keeps the same compact title layer. */
.main-sticky{position:-webkit-sticky;position:sticky;top:var(--main-nav-height,0px);z-index:20;margin:0 calc(-1 * var(--gutter)) 24rpx;padding:14rpx var(--gutter);background:var(--bg);border-bottom:1rpx solid var(--sep);box-shadow:0 6rpx 16rpx var(--shadow)}
.compact-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:64rpx}.compact-title{flex:1;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:30rpx;font-weight:600;line-height:44rpx;letter-spacing:1rpx;color:var(--text);min-width:0;overflow-wrap:anywhere}
.main-sticky button.compact-action:not([size=mini]){width:auto;max-width:55%;flex:none;margin:0;padding:10rpx 20rpx;min-height:64rpx;line-height:44rpx;font-size:26rpx;font-weight:500;color:var(--primary);background:var(--primary-soft);border-radius:32rpx;box-sizing:border-box}.compact-action::after{border:0}
.main-sticky .chip-bar{margin:10rpx 0 0;padding:0}.plaza-sticky .compact-title{padding:0 4rpx 10rpx}.plaza-sticky .rt-segments{margin-top:0}.plaza-sticky .rt-segments text{padding-top:10rpx;padding-bottom:10rpx}.plaza-sticky [data-section]{min-height:44rpx;display:flex;align-items:center;justify-content:center}
/* Dedicated left text column and right photograph; no words can cover the glass/lantern. */
.premium-plaza-hero{position:relative;display:flex;align-items:center;min-height:260rpx;box-sizing:border-box;overflow:hidden;margin:0 calc(-1 * var(--gutter)) 16rpx;padding:26rpx var(--gutter)}
.premium-plaza-copy{position:relative;z-index:1;width:50%;max-width:50%;box-sizing:border-box;padding-right:14rpx;flex:none}
.premium-plaza-photo{position:absolute;right:0;top:0;width:46%;height:100%;opacity:.94;pointer-events:none;object-fit:contain}
.premium-plaza-shade{position:absolute;left:54%;right:0;top:0;bottom:0;pointer-events:none;background:linear-gradient(90deg,var(--bg),transparent 12%,transparent 96%,var(--bg))}
.premium-plaza-copy .large-title,.premium-plaza-copy .title{padding:0;font-size:54rpx;line-height:72rpx;letter-spacing:1rpx;font-weight:600;word-break:normal;overflow-wrap:anywhere}
.premium-plaza-copy .large-sub,.premium-plaza-copy .tagline{display:block;max-width:100%;padding:12rpx 0 0;color:var(--primary);font-family:inherit;font-size:28rpx;line-height:44rpx;white-space:normal;word-break:normal;overflow-wrap:anywhere}
.premium-page-hero{min-height:260rpx}.premium-inner-hero{min-height:210rpx}.premium-inner-hero .title,.premium-inner-hero .large-title{font-size:46rpx;line-height:62rpx}
.screen .premium-profile-hero{position:relative;overflow:hidden;min-height:240rpx;padding:32rpx 50% 16rpx 0;box-sizing:border-box}.premium-profile-hero .pf-avatar-btn,.premium-profile-hero .pf-head-name,.premium-profile-hero .pf-head-sub{position:relative;z-index:1;max-width:100%;overflow-wrap:anywhere}
.premium-compact-hero{position:relative;overflow:hidden}.premium-compact-photo{position:absolute;right:0;top:0;width:200rpx;height:100%;opacity:.30;pointer-events:none}.premium-compact-hero>text{position:relative;z-index:1}
@media(max-width:350px){.premium-plaza-copy .large-title{font-size:54rpx}.premium-plaza-hero{margin-left:calc(-1 * var(--gutter));margin-right:calc(-1 * var(--gutter))}.main-sticky button.compact-action:not([size=mini]){padding-left:16rpx;padding-right:16rpx}}
